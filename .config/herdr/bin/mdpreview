#!/bin/sh
# Preview a markdown file (mermaid included) in the desktop browser, or in a
# terminal-browser pane.
#   mdpreview README.md            # a desktop browser tab
#   mdpreview --browser [file.md]  # the same; with no file, the latest one
#   mdpreview --term README.md     # a terminal-browser pane in this herdr tab
#   mdpreview -- snapshot          # a `terminal-browser action` command, aimed
#   mdpreview -- console           # at this tab's pane preview - no browser
#   mdpreview -- screenshot /tmp/preview.png   # key or tab id to pass around
#   mdpreview --pane
#   mdpreview --reset [file.md]
#   mdpreview --stop
#
# Starts a local render server on first use and reuses it afterwards; the page
# live-reloads when the file changes. Nothing in that server knows about herdr -
# it serves plain HTTP on the loopback port below - so the same preview shows in
# an ordinary browser tab, and that is where a file goes unless --term asks for
# a pane. A browser tab is the one surface that works the same from a herdr pane
# and from a plain terminal.
#
# Which terminal-browser tab in this herdr tab holds the preview is decided
# here, in every mode that has one to decide. Nothing outside needs to read
# `terminal-browser ls` to use a preview, and nothing outside should have to.
# The browser-tab modes have nothing to look up, which is exactly what lets them
# run from a plain terminal where that list has nothing to say.
set -e

port=${MDPREVIEW_PORT:-43128}
base="http://127.0.0.1:${port}"

self=$0
# Follow the ~/bin symlink back to the copy inside the dotfiles repo.
if command -v readlink >/dev/null 2>&1 && readlink -f "$self" >/dev/null 2>&1; then
  self=$(readlink -f "$self")
fi
root=$(CDPATH= cd -- "$(dirname -- "$self")/../mdpreview-server" && pwd)

# The render servers listening on ${port}, whatever directory they were started
# from. Both halves of that matter. Matching only the directory reaches servers
# this command was not asked about - a second checkout, or this one under another
# MDPREVIEW_PORT, which the port is a knob precisely so you can run. Matching only
# the port reaches whatever unrelated program happens to be holding it. Neither is
# ours to kill; the one on this port that is a render server is.
#
# Not anchored on `bun run`, so the bare `bun` form matches too, and not anchored
# on ${root} either: a server started before this directory was renamed, or from
# another checkout, answers /health here indistinguishably from ours and has to be
# reachable to be retired.
server_pids() {
  for pid in $(lsof -ti "tcp:${port}" -sTCP:LISTEN 2>/dev/null); do
    if ps -o command= -p "$pid" 2>/dev/null | grep -qE 'mdpreview(-server)?/server\.ts'; then
      printf '%s\n' "$pid"
    fi
  done
}

# Whether that server is the copy in ${root} rather than one from somewhere else.
server_is_ours() {
  ps -o command= -p "$1" 2>/dev/null | grep -qF "${root}/server.ts"
}

stop_server() {
  pids=$(server_pids)
  if [ -n "$pids" ]; then
    kill $pids 2>/dev/null || true
  fi
  # The port has to come free before a replacement can bind it.
  deadline_in 5
  while [ -n "$(server_pids)" ] && before_deadline; do
    sleep 0.2
  done
  [ -n "$pids" ]
}

# The preview belongs in the tab it was asked for from, so which browser to reuse
# is a per-tab question: a terminal-browser in another tab is a page nobody here
# can see, and navigating it looks exactly like nothing happening.
#
# Both ids are required together. Scoping reuse to a tab while splitting panes
# off wherever the focus happens to be would find nothing next run and open
# another, every run.
scoped=0
if [ -n "${HERDR_TAB_ID:-}" ] && [ -n "${HERDR_PANE_ID:-}" ]; then
  scoped=1
fi

# An absolute path rather than the bare name, because the split in open_preview
# runs it from a fresh shell in another pane, whose PATH is whatever that shell's
# startup files make it and not necessarily this one's.
tb=$(command -v terminal-browser 2>/dev/null) || tb=''

# $1 names the mode asking. Only --term has a way round a missing
# terminal-browser - the same file in a browser tab - and the modes that act on
# a pane preview have none: a browser tab is not something they can act on.
require_tb() {
  if [ -n "$tb" ]; then
    return 0
  fi
  if [ "$1" = --term ]; then
    echo "mdpreview: terminal-browser is not on PATH - install it (see the dotfiles README); 'mdpreview <file.md>' opens a browser tab without it" >&2
  else
    printf '%s\n' "mdpreview: $1 needs terminal-browser, which is not on PATH - install it (see the dotfiles README)" >&2
  fi
  exit 1
}

# Refuses an option where a file was expected. The markdown spellings are let
# through before anything that starts with `-` is refused, the same order the
# file argument itself is checked in at the bottom, so a file really called
# `--term.md` or `./--term` can still be named.
not_an_option() {
  case $1 in
    *.md | *.markdown | *.mdown | */*) ;;
    -*)
      printf '%s\n' "mdpreview: unknown option: $1" >&2
      usage
      ;;
  esac
}

# Refuses anything after the file. Left unchecked it was dropped without a
# word, so `mdpreview README.md --term` opened a browser tab and looked like
# --term had failed to do anything. $1 is the stray argument, $2 the form that
# puts the flag where it is read.
no_more_args() {
  printf '%s\n' "mdpreview: unexpected argument after the file: $1 - flags go first ('$2')" >&2
  exit 1
}

die_panes() {
  echo "mdpreview: could not split a herdr pane - is herdr working?" >&2
  exit 1
}

die_ls() {
  echo "mdpreview: could not read the terminal-browser list - is terminal-browser working?" >&2
  exit 1
}

require_tab() {
  if [ "$scoped" != 1 ]; then
    printf '%s\n' "mdpreview: $1 needs a herdr pane to scope to - there is no tab to look in from a plain terminal" >&2
    exit 1
  fi
}

# The whole terminal-browser list, every browser in the session. `--all` rather
# than this tab's narrowing because of how that narrowing is done: each browser
# is asked where it is, with 300ms to answer, and one too busy to answer in time
# is not left in this tab with its pane unknown - it is left out. With --all it
# stays in, pane and all null, and the absence is something to see rather than a
# preview that silently is not there. The tab is matched below either way.
read_listing() {
  listing=$("$tb" ls --all --json) || die_ls
}

# This tab's preview tabs from `listing`, one per line as `browser-key TAB
# tab-id TAB pane-id TAB all TAB target`, the active one first; empty when the
# tab has none. `all` is 1 when every tab in that browser is a preview, which is
# what decides whether closing the preview may take the pane with it. `target`
# is the tab's CDP target, empty while the page is still starting: `ls` lists a
# tab before it has one, and every `action` against it fails until it does.
#
# A preview is a tab on this render server, and nothing else is: a browser in
# this tab that the user opened for something of their own is not one, and
# navigating it would throw away whatever they had open. Matching on the URL is
# also what keeps a server on another MDPREVIEW_PORT out of it - its previews are
# that server's to manage. `/?` and a bare `/` are the two shapes a preview URL
# takes, links between previewed files included; /health and the other
# endpoints are not previews even though they are on the same server.
#
# The tab that counts is the one in HERDR_TAB_ID that the split below goes into,
# not terminal-browser's own idea of "this tab".
#
# A shape this does not recognize has to fail rather than read as "no preview":
# `null | length` is 0, so a quiet mismatch would split off a fresh pane on every
# run. `-s` is what makes that guard cover a silent terminal-browser as well.
# Given no input at all, jq never runs the program and exits 0 - so a CLI that
# dies without printing would otherwise read as a tab with no preview in it.
# Slurped, no input is `[]` and `.[0]` is null, which the guard rejects like any
# other shape it does not know.
previews() {
  printf '%s' "$listing" | jq -rs --arg tab "$HERDR_TAB_ID" --arg base "$base" '
    def preview: (.url // "") as $u | ($u | startswith($base + "/?")) or $u == $base + "/";
    .[0].browsers
    | if type == "array" then . else error("unexpected terminal-browser ls shape") end
    | [ .[]
        | select(.pane.tab == $tab and .key != null and .pane.pane != null)
        | . as $b
        | ([$b.tabs[]? | select(preview)]) as $here
        | (($here | length) == ($b.tabs | length)) as $all
        | $here[]
        | {key: $b.key, tab: .id, pane: $b.pane.pane, all: $all,
           active: (.active == true), target: (.targetId // "")} ]
    | sort_by(if .active then 0 else 1 end)
    | .[]
    | [.key, (.tab | tostring), .pane, (if .all then "1" else "0" end), .target]
    | @tsv
  '
}

# Whether `listing` might be missing a browser in this tab: one that did not say
# where it is in time, or one in this tab whose tabs could not be read - ls
# reports those as no tabs at all rather than failing. Either can be a preview
# that is there and busy, and taking its absence at face value splits a second
# pane beside it.
listing_unsure() {
  printf '%s' "$listing" | jq -es --arg tab "$HERDR_TAB_ID" '
    .[0].browsers
    | if type == "array" then . else error("unexpected terminal-browser ls shape") end
    | any(.[]; .pane.pane == null or (.pane.tab == $tab and (.tabs // [] | length) == 0))
  ' >/dev/null
}

# Any browser in this tab, preview or not, for a new tab to go into rather than a
# second pane beside it. Empty when the tab has none.
#
# A browser with no tabs is passed over. That is what one whose pane has just
# been closed looks like while it is still on its way out, and a tab handed to
# it goes down with it.
browser_here() {
  printf '%s' "$listing" | jq -rs --arg tab "$HERDR_TAB_ID" '
    .[0].browsers
    | if type == "array" then . else error("unexpected terminal-browser ls shape") end
    | map(select(.pane.tab == $tab and .key != null and (.tabs // [] | length) > 0))
    | .[0].key // empty
  '
}

# Sets `found` to this tab's previews and `key`, `tabid` and `target` to the
# first of them, all empty when it has none. The first line is the active tab
# when there is one, so a browser holding two previews is driven on the one the
# user can see.
#
# `resolve_preview settle` is for a lookup whose "none" is acted on - by opening
# a preview, or by refusing. When the list might be missing a browser it is read
# once more before none is believed. The polling loops leave it off: they ask
# again anyway.
resolve_preview() {
  read_listing
  found=$(previews) || die_ls
  if [ -z "$found" ] && [ "${1:-}" = settle ] && listing_unsure; then
    sleep 0.5
    read_listing
    found=$(previews) || die_ls
  fi
  line=$(printf '%s\n' "$found" | head -n 1)
  key=$(printf '%s' "$line" | cut -f1)
  tabid=$(printf '%s' "$line" | cut -f2)
  target=$(printf '%s' "$line" | cut -f5)
}

require_deps() {
  if [ ! -d "${root}/node_modules" ]; then
    printf '%s\n' "mdpreview: dependencies missing - run 'bun install' in ${root}" >&2
    exit 1
  fi
}

# Sets `file` to an absolute path, rejecting one that is not there. The directory
# is resolved on its own so that a path with no directory to cd into is reported
# as the missing file it is, rather than as cd's complaint plus whatever `pwd`
# never printed - which reads as a different path than the one asked for.
resolve_file() {
  dir=$(CDPATH= cd -- "$(dirname -- "$1")" 2>/dev/null && pwd) || dir=""
  if [ -z "$dir" ] || [ ! -f "${dir}/$(basename -- "$1")" ]; then
    printf '%s\n' "mdpreview: no such file: $1" >&2
    exit 1
  fi
  file="${dir}/$(basename -- "$1")"
}

ensure_server() {
  # Whoever holds ${port} has to be the server in ${root}. /health cannot tell one
  # server from another, so on its own it would hand back a server from another
  # directory for as long as that process lived - rendering with code this copy
  # does not have, silently. Retiring it here is what keeps the health check below
  # meaning "our server is up" rather than "something answers".
  #
  # Scoped to this port: our own copy serving another MDPREVIEW_PORT is a separate
  # preview, not a stale one, and has no bearing on who should hold this one.
  #
  # Without lsof the holder cannot be identified, and this carries on anyway
  # rather than refusing the way `--stop` does: refusing would trade a check that
  # only matters when a server from elsewhere is already here for a preview that
  # never works at all. What must not be skipped is saying so, because the
  # failure it leaves open - rendering through the wrong server's code - shows up
  # as nothing more than a page that will not change.
  if ! command -v lsof >/dev/null 2>&1 &&
      curl -fsS -m 1 "${base}/health" >/dev/null 2>&1; then
    printf '%s\n' "mdpreview: no lsof, so the server already on ${port} cannot be identified - if the preview renders stale, stop that process by hand" >&2
  fi
  for pid in $(server_pids); do
    if ! server_is_ours "$pid"; then
      stop_server
      break
    fi
  done
  if ! curl -fsS -m 1 "${base}/health" >/dev/null 2>&1; then
    # --retry-connrefused lets the first request wait out the server's startup.
    nohup bun run "${root}/server.ts" >>"${TMPDIR:-/tmp}/mdpreview-server.log" 2>&1 &
    # Each connection-refused retry would otherwise print its own error, so the
    # retry output is dropped and the final failure is reported here instead.
    if ! curl -fsS --retry 30 --retry-delay 0 --retry-connrefused -m 10 \
        "${base}/health" >/dev/null 2>/dev/null; then
      printf '%s\n' "mdpreview: server did not start on ${base} - see ${TMPDIR:-/tmp}/mdpreview-server.log" >&2
      exit 1
    fi
  fi
}

# Sets `file` to whatever the render server is currently showing, for the modes
# that take no file argument, and leaves our own server up and ready to show it
# again. Everything a named file needs, in other words, for the case where the
# file is not named but is already on screen.
#
# A server has to be up already: a fresh one has no current file, and starting
# one here would restore onto a blank page. jq turns a silent curl into empty
# output rather than a failure.
#
# The file is read before ownership of the port is settled, and deliberately so.
# The server answering may be one this copy does not own - left from before the
# rename, or another checkout - and its current file is still the file on screen,
# which is the thing being restored. Retiring it first would throw away the only
# record of what to restore onto. ensure_server then makes our server the one
# that gets the file back and the one the pane or tab is pointed at, so nothing
# afterwards renders through code this copy does not have.
#
# require_deps waits until there is something to restore, for the same reason:
# complaining about node_modules is the right answer when a preview is wanted
# and the wrong one when the answer is that there is no preview to return to.
# $1 picks which of the two files /health reports to come back to. `current` is
# the file a bare / renders, which is the one the pane modes last opened and so
# the one --reset means by "whatever is on screen". `recent` is the most recent
# /open of any kind, which is what --browser means: a browser preview - the
# default one included - registers its file without making it current, precisely
# so that it cannot drag a pane along, and would otherwise have nothing to resume
# from at all.
#
# `.recent // .file` also covers an older server on this port, which ensure_server
# below goes out of its way to contemplate: no `recent` field means fall back to
# the one field it does have.
#
# Both fields are read either way, so that a failure can say which kind of
# nothing it found. jq turns a silent curl - or a foreign server answering
# something that is not JSON - into empty output rather than a failure.
resume_current_file() {
  health=$(curl -fsS -m 2 "${base}/health" 2>/dev/null) || health=''
  recent=$(printf '%s' "$health" | jq -r '.recent // .file // empty' 2>/dev/null) \
    || recent=''
  if [ "$1" = recent ]; then
    file=$recent
  else
    file=$(printf '%s' "$health" | jq -r '.file // empty' 2>/dev/null) || file=''
  fi
  if [ -z "$file" ]; then
    # A pane mode finding no pane-side file while a browser tab is holding one is
    # not "nothing is being previewed" - something is, and saying otherwise is
    # false in exactly the state it prints in. A browser tab never moves the
    # current file, on purpose, and a tab is what a plain `mdpreview <file.md>`
    # opens. --reset only gets here with a pane preview in this tab, so this is a
    # server that has lost the pane's file - restarted since, say - while a tab
    # kept one. What --reset needs is a file to rebuild onto, so it asks for one
    # rather than adopting the tab's.
    #
    # With nothing at all, the advice depends on who is asking: --reset rebuilds
    # a pane, so pointing it at the default would open a tab it cannot reset.
    if [ "$1" != recent ] && [ -n "$recent" ]; then
      printf '%s\n' "mdpreview: nothing is being previewed in a pane - ${recent} is open in a browser tab, which --reset does not rebuild; name a file: 'mdpreview --reset <file.md>'" >&2
    elif [ "$1" != recent ]; then
      echo "mdpreview: nothing is being previewed in a pane - run 'mdpreview --term <file.md>'" >&2
    else
      echo "mdpreview: nothing is being previewed - run 'mdpreview <file.md>'" >&2
    fi
    exit 1
  fi
  if [ ! -f "$file" ]; then
    printf '%s\n' "mdpreview: the previewed file is gone: $file" >&2
    exit 1
  fi
  require_deps
  ensure_server
}

# Registers the file with the render server, which is also what reloads a page
# already showing it - so the call waits until every check that could still fail
# has passed: an error that leaves the pane showing the new file would be
# reporting a failure it did not have.
#
# `set_file aside` registers without making the file the current one. Only the
# browser path - the default - uses it, and the reason is on the server side, at
# registerFile: a page reached through a bare / follows the current file and
# would be dragged onto a file someone asked to see in a tab of its own. Panes
# are on their own ?file= URL and never see it either way.
#
# curl runs without -f on purpose. The server refuses a path it will not render
# - a suffix outside the markdown set it recognises, a file it cannot read - and
# answers 400 with the reason in the body's `error` field. -f throws that body
# away, so all that reaches the caller is `curl: (22) The requested URL returned
# error: 400`, naming neither the file nor what was wrong with it, and set -e
# ends the run on curl's status before anything can say more. --fail-with-body
# would keep the status and the body together in one flag, and is not used
# because it arrived in curl 7.76 while this runs on whatever curl the machine
# came with. So success is read out of the reply instead, and curl's own status
# is left to mean the one thing it still reports usefully: no reply arrived.
#
# Which is not the same as nothing having happened, and the message is careful
# not to say otherwise. server.ts sets the current file and broadcasts the
# reload before it writes the response, and curl exits non-zero for a partial
# transfer or an empty reply as readily as for a connection it never made - so a
# server killed mid-answer leaves every page on this preview already navigated
# with no way for this to know.
#
# -m because this was the only curl in the file without one, and a server that
# accepts the connection and then never answers would hang the run forever with
# nothing on screen to say why.
set_file() {
  current=true
  if [ "${1:-}" = aside ]; then
    current=false
  fi
  if ! reply=$(jq -n --arg path "$file" --argjson current "$current" \
        '{path: $path, current: $current}' \
      | curl -sS -m 10 -X POST -H 'content-type: application/json' --data @- "${base}/open"); then
    printf '%s\n' "mdpreview: no reply from the render server on ${base} - ${file} may already have reached it" >&2
    exit 1
  fi
  # A reply that is not the object expected here has to read as a refusal and
  # not as consent. jq indexing a string is an error rather than a false, and
  # taking that quietly would report a preview the server never accepted.
  #
  # `.ok == true` rather than `.ok // false`, which under -r prints the string
  # "true" for a `{"ok":"true"}` and passes the test below. Ours never sends
  # that; a foreign server on this port is exactly the case none of this can
  # assume anything about.
  ok=$(printf '%s' "$reply" \
    | jq -r 'if type == "object" then (.ok == true) else false end' 2>/dev/null) \
    || ok=false
  if [ "$ok" = true ]; then
    return 0
  fi
  reason=$(printf '%s' "$reply" \
    | jq -r 'if type == "object" then (.error // empty) else empty end' 2>/dev/null) \
    || reason=''
  if [ -z "$reason" ]; then
    # jq finding no reason in a body it could not parse means it could not read
    # one, not that there was none to read - and dropping -f above was the whole
    # point of not discarding bodies. server.ts answers a bad Host or an
    # unexpected Origin with a bare `forbidden`, and a foreign server on this
    # port owes us no JSON at all, so the body itself is the reason in that
    # case. One line and cut short, because this prints on one line of a
    # terminal and an unknown server may well answer with an HTML page.
    reason=$(printf '%s' "$reply" | head -n 1 | cut -c1-200)
  fi
  if [ -z "$reason" ]; then
    reason="it refused and said nothing about why"
  fi
  printf '%s\n' "mdpreview: the render server on ${port} would not take ${file} - ${reason}" >&2
  exit 1
}

# The URL for one preview surface, with the file in the query rather than left to
# whatever the server happens to think is current. That is what makes two
# previews possible at once: a pane in this tab, a pane in another, and any
# number of browser tabs each hold their own path, and a save reloads only the
# pages showing that path.
#
# $1 is the surface, `pane` or `tab`. The server cannot tell them apart - both
# are Chrome asking for a page - so the page carries the answer for the sake of
# the duplicate-tab check, which must count tabs and not panes.
#
# @uri and not the path as typed: a path may hold spaces, and a `&` or a `#` in
# one would otherwise end the query or the URL early, handing the server half a
# path and an argument it never saw.
preview_url() {
  printf '%s/?file=%s&surface=%s\n' \
    "$base" "$(jq -rn --arg p "$file" '$p|@uri')" "$1"
}

# How many browser tabs already have this file open, or 0 when the question
# cannot be answered - an older server has no /viewers, and its silence has to
# read as "no tabs" so that the preview still happens.
#
# Only tabs count. A herdr pane showing the same file is not a reason to refuse
# someone who asked for a browser tab, and server.ts excludes it for that reason.
tab_viewers() {
  count=$(curl -fsS -m 2 "${base}/viewers?file=$(jq -rn --arg p "$file" '$p|@uri')" \
    2>/dev/null | jq -r '.count // 0') || count=0
  case $count in
    '' | *[!0-9]*) count=0 ;;
  esac
  printf '%s\n' "$count"
}

# Polls run against the clock rather than a count of attempts. Each attempt is
# a `terminal-browser ls`, which takes as long as the slowest browser takes to
# say where it is, so a count of 0.2s sleeps says nothing about how long the
# wait was. `date +%s` is whole seconds, so a wait can run up to one short.
deadline_in() {
  deadline=$(($(date +%s) + $1))
}

before_deadline() {
  [ "$(date +%s)" -lt "$deadline" ]
}

# Waits up to $1 seconds for this tab's preview to show up in `terminal-browser
# ls` with a CDP target, and leaves it in `key`, `tabid` and `target`. A run
# that returned before then would leave the next one - `mdpreview --term a.md &&
# mdpreview -- snapshot` - finding no preview and refusing, or opening another.
# Listed is not enough: a tab is listed before its page has a target, and
# `action` refuses it until then, so a preview that only counts as up once it is
# listed hands that refusal to whatever runs next.
wait_preview() {
  deadline_in "$1"
  while :; do
    resolve_preview
    if [ -n "$key" ] && [ -n "$target" ]; then
      return 0
    fi
    before_deadline || return 1
    sleep 0.2
  done
}

# The label open_preview puts on a pane it splits, and the only thing that
# lets close_previews take a pane down. A pane that merely runs a browser full
# of previews may be the user's own shell, running `terminal-browser open` in
# the foreground; closing it would take the shell and anything else in it.
pane_label=mdpreview

# Puts the preview on screen in this tab when it has none. Sets `opened` to say
# where, for the message.
#
# A browser already in this tab gets the preview as a new tab rather than a
# second pane beside it, and that browser's own tabs are left where they were -
# it is somebody's page, not a preview to navigate away.
#
# With no browser here, the pane is split off by herdr and terminal-browser is
# started inside it, rather than left to `terminal-browser open --split`. That
# command splits with --focus, and herdr's --focus pulls the whole UI over to
# this tab: an agent previewing in a workspace nobody is looking at would drag
# the user out of whatever they were doing. --no-focus keeps them there, and
# the preview is something to glance at, not something to be taken to.
#
# The split is off this pane, so the preview lands beside whoever asked for it
# rather than beside whichever pane happens to be focused. --right-click pane
# hands right-clicks to the browser, as terminal-browser's own split does.
#
# `exec` so that quitting the browser closes the pane instead of leaving a
# shell behind in it, and --no-merge so that terminal-browser opens a browser in
# this pane rather than deciding a neighbour would do and leaving the pane empty.
#
# The URL and the command reach that shell through the split's environment, and
# the line typed into it is the same short one every time. herdr types it into a
# tty in canonical mode, which refuses a line over 1024 bytes - and a path with
# Japanese in it percent-encodes to 9 bytes a character, so a deep one passes
# that on its own. Through the environment nothing needs quoting for the shell
# either. The leading space keeps the line out of zsh's history, which
# HIST_IGNORE_SPACE in zshrc honours.
#
# A pane this run split is closed again when the preview does not come up in
# it - whether the line was refused or the browser never registered - rather
# than left behind as an empty shell beside the caller, which the next run would
# not recognise as a preview and would split another one next to.
open_preview() {
  read_listing
  here=$(browser_here) || die_ls
  if [ -z "$here" ] && listing_unsure; then
    sleep 0.5
    read_listing
    here=$(browser_here) || die_ls
  fi
  new=''
  if [ -n "$here" ]; then
    "$tb" new-tab --browser "$here" "$(preview_url pane)" >/dev/null
    opened="in a new tab of this tab's browser"
  else
    split=$(herdr pane split --pane "$HERDR_PANE_ID" --direction right \
        --no-focus --right-click pane \
        --env "MDPREVIEW_TB=${tb}" --env "MDPREVIEW_URL=$(preview_url pane)") \
      || die_panes
    new=$(printf '%s' "$split" | jq -r '.result.pane.pane_id // empty' 2>/dev/null) || new=''
    if [ -z "$new" ]; then
      die_panes
    fi
    herdr pane rename "$new" "$pane_label" >/dev/null 2>&1 || true
    # shellcheck disable=SC2016 # expanded by the new pane's shell, not this one
    if ! herdr pane run "$new" \
        ' exec "$MDPREVIEW_TB" open --no-merge "$MDPREVIEW_URL"' >/dev/null; then
      herdr pane close "$new" >/dev/null 2>&1 || true
      printf '%s\n' "mdpreview: could not start terminal-browser in a new herdr pane - is herdr working?" >&2
      exit 1
    fi
    opened="in a new pane"
  fi
  # A cold start - the first browser since terminal-browser's shared process
  # last exited - takes a few seconds; a warm one is there within a second.
  if ! wait_preview 30; then
    if [ -n "$new" ]; then
      herdr pane close "$new" >/dev/null 2>&1 || true
    fi
    echo "mdpreview: the preview did not come up in terminal-browser within 30s - is it starting or stuck?" >&2
    exit 1
  fi
}

# Points this tab's preview at the current file. `action -- open` is not the way:
# despite its "Navigate to URL" it opens a new tab every time, so a preview
# driven by it would grow a tab per run. The page is told to go instead.
#
# A preview with no CDP target yet is a page still starting, not a dead one, and
# is waited for rather than given up on - giving up replaces it, which closes
# the pane that a run moments ago opened and opens another. Only a preview that
# still has no target after the wait, or that has one and refuses the eval, is
# reported as not answering.
#
# The navigation is deferred to a task of its own, so the eval's own reply is
# sent before the page starts unloading and cannot be lost to it.
#
# --follow brings the preview to the front of its browser, so a file previewed
# while the user had switched that browser to another tab is not navigated
# behind their back. It moves nothing in herdr. `done` afterwards clears the
# "agent is acting" marker the action puts on the tab, which would otherwise
# sit on a preview nobody is driving.
navigate_preview() {
  if [ -z "$target" ] && ! wait_preview 10; then
    return 1
  fi
  url=$(jq -n --arg u "$(preview_url pane)" '$u')
  if ! "$tb" action --follow --browser "$key" --tab "$tabid" -- \
      eval "setTimeout(() => location.replace(${url}), 0); true" >/dev/null 2>&1; then
    return 1
  fi
  "$tb" action --browser "$key" --tab "$tabid" 'done' >/dev/null 2>&1 || true
}

# Closes every preview in this tab and waits for them to leave the list: a
# preview still listed would be found again by the reopen that follows, and the
# tab in the middle of closing would be handed back as the result. Returns 2
# when there was nothing to close.
#
# A browser holding nothing but previews, in a pane open_preview split for it,
# goes with its pane, closed by herdr rather than left to follow its browser
# out. Any other pane stays, and only the preview tabs are closed: a browser
# with tabs of its own keeps them, and a pane mdpreview did not split is not
# mdpreview's to close, whatever is running in it. A browser there that held
# nothing but previews exits once its last tab is closed - terminal-browser does
# that by itself - and the pane is left with whatever started it, a shell as
# like as not.
#
# A browser whose pane was closed is also waited out of the list, not just its
# previews. On its way out it can still be listed with no tabs, and a reopen
# that found it there would hand the new preview to a browser about to exit.
close_previews() {
  resolve_preview settle
  if [ -z "$found" ]; then
    return 2
  fi
  gone=$(printf '%s\n' "$found" | while IFS="$(printf '\t')" read -r k t p all _; do
    [ -n "$k" ] || continue
    label=$(herdr pane get "$p" 2>/dev/null | jq -r '.result.pane.label // empty' 2>/dev/null) \
      || label=''
    if [ "$all" = 1 ] && [ "$label" = "$pane_label" ]; then
      herdr pane close "$p" >/dev/null 2>&1 || true
      printf '%s\n' "$k"
    else
      "$tb" action --browser "$k" --tab "$t" -- tab close "$t" >/dev/null 2>&1 || true
    fi
  done)
  deadline_in 5
  while :; do
    resolve_preview
    lingering=$(printf '%s' "$listing" | jq -rs --arg gone "$gone" '
      ($gone | split("\n") | map(select(. != ""))) as $g
      | [.[0].browsers[]? | select(.key as $k | $g | index([$k]))] | length
    ') || die_ls
    if [ -z "$key" ] && [ "$lingering" = 0 ]; then
      return 0
    fi
    before_deadline || break
    sleep 0.2
  done
  echo "mdpreview: the preview in this tab did not close" >&2
  exit 1
}

# The command that hands a URL to the desktop browser, or nothing when the
# machine has neither. Chosen by platform rather than by which name turns up on
# PATH first: on Darwin `open` opens a URL, but on Linux a program called `open`
# is as likely to be something else - util-linux ships `openvt` and some
# distributions link `open` to it, and a personal shim under that name is a
# common enough habit - and preferring it there would spend the run on something
# that was never going to show a page while `xdg-open` sat untried next to it.
# Each platform's second choice is kept rather than dropped: a Darwin box
# without `open` is odd but not a reason to refuse, and neither is a Linux one
# where only the macOS name has been shimmed in.
#
# Prints the name rather than running it, so that the caller decides when - see
# preview_in_browser, where the when is the point.
find_opener() {
  if [ "$(uname -s)" = Darwin ]; then
    first=open
    second=xdg-open
  else
    first=xdg-open
    second=open
  fi
  if command -v "$first" >/dev/null 2>&1; then
    printf '%s\n' "$first"
  elif command -v "$second" >/dev/null 2>&1; then
    printf '%s\n' "$second"
  fi
}

# The whole of a browser preview once the file and the server are settled.
#
# The opener is resolved before set_file and run after it, and that order is the
# point. set_file navigates every page on this preview, a herdr pane included,
# so the one opener failure knowable in advance - none installed at all - has to
# be reported while nothing has changed yet; otherwise the run moves someone's
# pane and then reports that nothing was shown. The other failure, an opener
# that exists and exits non-zero, cannot be known without running it and so
# necessarily lands after; set -e ends the run on it, with whatever the opener
# itself had to say.
#
# The file still goes to the server before the tab is opened, and not the other
# way round: a tab that loads first renders whatever the server was holding, and
# the reload that POSTing the file broadcasts only reaches a page already
# listening on /events - which a tab still starting up is not. Opening second
# costs nothing, because the page is rendered per request. The opener returns as
# soon as the browser has been told, so there is nothing to wait for and nothing
# to report back beyond having asked - and nothing terminal-browser can name,
# which is the difference the passthrough has to account for.
#
# Focus is taken, and that is the choice rather than an oversight. open_preview
# splits with --no-focus because a pane is already on screen in a tab being looked
# at, so taking the keyboard for it would interrupt whoever asked - but asking
# to see a file is asking to be shown it, and a tab that opens behind the
# terminal is a preview that did not happen. Being the default does not change
# that; --term is there for a preview that should stay beside the terminal.
# A tab already showing this file is left alone rather than joined by a second
# one. `open` starts a tab; it does not look for an existing one, so without this
# every run stacked another tab on the same preview - and the file has just been
# re-registered, which reloads the tab that is already there, so the preview is
# as fresh as a new tab would have been.
#
# The count comes from live SSE connections, so a tab Chrome has discarded or
# frozen in the background reads as gone and a second one opens. Erring that way
# is deliberate: the alternative is refusing to show a preview because of a tab
# the user can no longer see.
preview_in_browser() {
  opener=$(find_opener)
  if [ -z "$opener" ]; then
    printf '%s\n' "mdpreview: no way to open a browser - neither open nor xdg-open is on PATH; the preview is at $(preview_url tab)" >&2
    exit 1
  fi
  # Asked before the file is handed over, and that ordering is not cosmetic:
  # registering it reloads every page already showing it, and a page in the
  # middle of a reload has dropped its EventSource and not yet reopened it. A
  # count taken afterwards races the very tab it is looking for and comes back 0,
  # which stacks a second tab on every run - the exact bug this is here to stop.
  showing=$(tab_viewers)
  set_file aside
  if [ "$showing" -gt 0 ]; then
    printf '%s\n' "mdpreview: ${file} is already open in a browser tab - reloaded that instead of opening another"
    return 0
  fi
  "$opener" "$(preview_url tab)"
  printf '%s\n' "mdpreview: previewing ${file} in a browser tab"
}

usage() {
  echo "usage: mdpreview <file.md> | --browser [file.md] | --term <file.md> | -- <terminal-browser action command> | --pane | --reset [file.md] | --stop" >&2
  exit 1
}

if [ "$1" = "--stop" ]; then
  # Without lsof there is no way to tell which server belongs to this port, and
  # killing by directory alone is what this exists to avoid. Saying so beats
  # reporting a stop that did not happen.
  if ! command -v lsof >/dev/null 2>&1; then
    printf '%s\n' "mdpreview: lsof is needed to find the server on ${port}" >&2
    exit 1
  fi
  # This tab's preview goes too: with the server gone it is a page that will
  # never reload again, and leaving it up reads as a preview that still works.
  # Only this tab's, and only previews - a browser with tabs of its own keeps
  # them. `terminal-browser shutdown` is not used for this because it takes
  # every terminal-browser in the session with it, previews or not.
  #
  # Outside herdr, or without terminal-browser, there is no preview here to
  # close and the server is the whole of it.
  #
  # The preview is closed in a subshell, because every way closing can fail
  # ends the run, and a terminal-browser that cannot be read or a preview that
  # will not close is not a reason to leave the server running - the part of
  # this that was asked for. Whatever went wrong has been said on stderr by
  # then, and the exit status still reports it once the server is down.
  closed=''
  status=0
  if [ "$scoped" = 1 ] && [ -n "$tb" ]; then
    outcome=0
    (close_previews) || outcome=$?
    case $outcome in
      0) closed=" and closed this tab's preview" ;;
      2) ;;
      *) closed=" but could not close this tab's preview"; status=1 ;;
    esac
  fi
  if stop_server; then
    printf '%s\n' "mdpreview: stopped the server on ${port}${closed}"
  else
    printf '%s\n' "mdpreview: no server on ${port}${closed}"
  fi
  exit "$status"
fi

if [ "$1" = "--pane" ]; then
  # Names the herdr panes holding this tab's previews, one id per line, for the
  # `herdr pane` commands - resizing one, say. Not renaming it: the `mdpreview`
  # label is what lets --reset and --stop close the pane, and a pane renamed
  # away from it keeps running with only its tabs closed. A browser that also holds
  # tabs of its own is named too, so closing what this prints can take those
  # with it; `--stop` and `--reset` are the ways to close only the preview.
  require_tab --pane
  require_tb --pane
  resolve_preview settle
  if [ -z "$found" ]; then
    echo "mdpreview: no preview in this tab - run 'mdpreview --term <file.md>' first" >&2
    exit 1
  fi
  printf '%s\n' "$found" | cut -f3 | awk '!seen[$0]++'
  exit 0
fi

if [ "$1" = "--reset" ]; then
  # Replaces this tab's preview instead of trying to revive it: closes it and
  # opens a new one on the same file. A preview that has stopped answering - a
  # page that no longer scrolls, a tab that ignores input - is cheaper to throw
  # away than to diagnose, and the page holds no state worth keeping.
  require_tab --reset
  require_tb --reset
  not_an_option "$2"
  if [ "$#" -gt 2 ]; then
    no_more_args "$3" "mdpreview --reset <file.md>"
  fi

  if [ -n "$2" ]; then
    require_deps
    resolve_file "$2"
    ensure_server
  else
    # No file named, and no pane preview in this tab: refused rather than
    # rebuilt. The file to come back to would be the server's current one, which
    # is whatever a pane in any tab last opened, so this would split a pane
    # nobody here asked for onto a file this tab may never have shown. Nothing
    # here is stuck either - a desktop tab, the usual preview now, is not one
    # --reset can replace. Naming a file is asking for a pane, and is honoured.
    resolve_preview settle
    if [ -z "$found" ]; then
      echo "mdpreview: no pane preview in this tab to reset - reload a browser tab yourself; 'mdpreview --term <file.md>' opens a pane" >&2
      exit 1
    fi
    # Reset onto whatever the pane modes last opened, which is what is on screen
    # in a pane. A file someone opened in a browser tab - the default surface -
    # is not that, and pulling this tab's pane onto it would be a reset onto
    # something the pane was never showing.
    resume_current_file current
  fi

  # Handed over before anything is closed, because closing is destructive and
  # this is the last step that can still refuse. `--reset FILE` never passes
  # through the spelling rule further down, so resolve_file admits any existing
  # path and the server is the first thing to reject it - which, done after the
  # close, would leave the tab with no preview for a replacement that was never
  # going to open. Same ordering the browser path gets, for the same reason.
  set_file

  close_previews || [ "$?" = 2 ]
  open_preview
  printf '%s\n' "mdpreview: reset ok - previewing ${file} ${opened}"
  exit 0
fi

if [ "$1" = "--browser" ]; then
  # What a bare file argument does anyway, kept as a spelling of its own because
  # it is how this was asked for before a browser tab became the default, and
  # because with no file it is the one way to reopen the latest preview. No pane
  # and no terminal-browser are involved, so it needs no herdr tab either.
  not_an_option "$2"
  if [ "$#" -gt 2 ]; then
    no_more_args "$3" "mdpreview --term <file.md>"
  fi
  if [ -n "$2" ]; then
    require_deps
    resolve_file "$2"
    ensure_server
  else
    # No file named: open a tab on the most recent file any surface was pointed
    # at, which is what "the preview" means to someone who did not name one.
    # Handing it back over broadcasts a reload, so a page already open on a long
    # document loses its scroll position - the cost of this taking the same route
    # as a named file rather than trusting a server it may not own.
    resume_current_file recent
  fi

  preview_in_browser
  exit 0
fi

if [ "$1" = "--" ]; then
  shift
  if [ "$#" = 0 ]; then
    usage
  fi
  # Everything after -- is handed to `terminal-browser action` against this
  # tab's preview. Naming the browser and tab belongs here and not to the
  # caller: left to itself, action drives the active tab of this tab's browser,
  # which is not the preview whenever the preview shares a browser with tabs of
  # someone's own. terminal-browser rejects a command it does not have, which
  # is why this needs no list of them to keep in step with. Nor does it keep one
  # of the commands terminal-browser handles itself rather than passing to the
  # page - `open` and `tab new` open a new tab, `tab close` closes one, and
  # `launch`, `connect` and the like are refused - since those answers come
  # from terminal-browser either way.
  #
  # Whatever the command turns out to be, it reaches the page over CDP, and the
  # only pages reachable that way are terminal-browser's. A tab handed to the
  # desktop browser is not one: nothing is attached to it, so unscoped there is
  # nothing here to drive at all. Saying so is the whole answer - reaching for
  # a preview in some other herdr tab would report on a page nobody here is
  # looking at, which reads as the preview and is not.
  #
  # printf and not echo, here and everywhere a message interpolates something:
  # /bin/sh on this platform and dash both expand backslash escapes in echo
  # without being asked, so a filename with a \t in it would be reported as a
  # different name than the one that was typed.
  if [ "$scoped" != 1 ]; then
    printf '%s\n' "mdpreview: '$1' would be run against a terminal-browser preview, and outside a herdr session there is none - the preview is a plain browser tab." >&2
    exit 1
  fi
  require_tb "'mdpreview -- <command>'"
  resolve_preview settle
  if [ -z "$key" ]; then
    # The desktop tab is named here because it is what a plain `mdpreview
    # <file.md>` opens, and this cannot reach it: it is not terminal-browser's,
    # so a preview opened moments ago still leaves this with nothing to drive
    # and reads as no preview at all. Without saying so, rerunning that same
    # command would look like the fix and only open another tab.
    echo "mdpreview: no preview in this tab - run 'mdpreview --term <file.md>' to open one; a preview opened without --term is a desktop tab and cannot be driven from here" >&2
    exit 1
  fi
  # A preview still starting has no CDP target, and action refuses it until it
  # has one - waited for here so that a command run right after the preview
  # was opened elsewhere does not fail on a page about to be there.
  if [ -z "$target" ] && ! wait_preview 10; then
    echo "mdpreview: the preview in this tab has no CDP target after 10s - is it stuck? 'mdpreview --reset' replaces it" >&2
    exit 1
  fi
  # `done` clears the "agent is acting" marker the action leaves on the tab. Refs
  # from a snapshot survive it, so a later `mdpreview -- click @e3` still works,
  # and running it after every command keeps the marker from sitting on a
  # preview nobody is driving any more. The command's own status is the one
  # that counts.
  status=0
  "$tb" action --browser "$key" --tab "$tabid" -- "$@" || status=$?
  "$tb" action --browser "$key" --tab "$tabid" 'done' >/dev/null 2>&1 || true
  exit "$status"
fi

# --term asks for a terminal-browser pane in this herdr tab, and is refused up
# front outside one rather than quietly turned into a browser tab: whoever wrote
# it wants a page that `mdpreview --` can drive, and a desktop tab is not that.
# Refused before the server is started, since nothing would be shown on it.
term=0
if [ "$1" = "--term" ]; then
  term=1
  shift
  if [ "$scoped" != 1 ]; then
    echo "mdpreview: --term opens a terminal-browser pane in this herdr tab, and outside a herdr session there is none - drop --term to open a browser tab" >&2
    exit 1
  fi
  # The two ways to get --term wrong that the generic checks below would only
  # answer with the usage line: leaving the file off, and stacking another flag
  # on it. Markdown spellings go through first, as in not_an_option.
  case ${1:-} in
    '') echo "mdpreview: --term needs a file: 'mdpreview --term <file.md>'" >&2; exit 1 ;;
    *.md | *.markdown | *.mdown | */*) ;;
    -*) printf '%s\n' "mdpreview: --term takes a file, not $1" >&2; exit 1 ;;
  esac
fi

if [ -z "$1" ]; then
  usage
fi
if [ "$#" -gt 1 ]; then
  no_more_args "$2" "mdpreview --term <file.md>"
fi

# A markdown path is the only thing taken as a file. That is decided on the
# spelling rather than on whether the path happens to exist, so `mdpreview
# snapshot` - the old way of driving the preview - cannot turn into a preview of
# a file called `snapshot` that someone left in the cwd. Write `./snapshot` to
# mean the file, and `mdpreview -- snapshot` to mean the command.
case $1 in
  *.md | *.markdown | *.mdown | */*) ;;
  -*)
    printf '%s\n' "mdpreview: unknown option: $1" >&2
    usage
    ;;
  *)
    printf '%s\n' "mdpreview: '$1' is not a markdown path - name a file with a .md suffix or a ./ prefix, or put a command for the preview after --: 'mdpreview -- $*'" >&2
    exit 1
    ;;
esac

if [ "$term" = 1 ]; then
  require_tb --term
fi
require_deps
resolve_file "$1"
ensure_server

if [ "$term" != 1 ]; then
  preview_in_browser
  exit 0
fi

resolve_preview settle

# The JSON that terminal-browser prints is of no use to whoever asked for a
# preview, and an agent reading it pays for every field of it. One line saying
# what happened covers it; failures still come through on stderr, and the
# pane is a `mdpreview --pane` away for anyone who wants it.
set_file
if [ -z "$key" ]; then
  open_preview
  printf '%s\n' "mdpreview: previewing ${file} ${opened}"
  exit 0
fi

# A preview that will not take the navigation - a tab that has stopped
# answering CDP - is replaced rather than reported: the caller asked to see a
# file, and a new preview shows it.
if ! navigate_preview; then
  printf '%s\n' "mdpreview: the preview in this tab did not answer - replacing it" >&2
  close_previews || [ "$?" = 2 ]
  open_preview
fi
printf '%s\n' "mdpreview: previewing ${file}"
