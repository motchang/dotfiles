.DS_*
node_modules/
dist/

# Per-machine Claude Code permissions. ~/.config/git/ignore covers this too, but
# that file is generated by gibo and is not tracked here, so a fresh machine
# would otherwise stage it.
.claude/settings.local.json

# Subagents are given an isolated git worktree under here. Each one is a full
# checkout of some other branch, not content that belongs to this repository.
.claude/worktrees/
